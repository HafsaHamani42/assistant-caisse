# Configuration Base de Données MySQL (Laragon)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projetmed
DB_USER=root
DB_PASS=

# Clé API Groq (Gratuit sur https://console.groq.com)
GROQ_API_KEY=votre_cle_api_ici

# Modèle Groq à utiliser
GROQ_MODEL=openai/gpt-oss-120b

# Timezone
TIMEZONE=Africa/Casablanca

# ========================================
# INSTRUCTIONS:
# ========================================
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplissez les valeurs ci-dessus
# 3. Ne partagez JAMAIS le fichier .env !
# 4. Ajoutez .env dans .gitignore
# ========================================
